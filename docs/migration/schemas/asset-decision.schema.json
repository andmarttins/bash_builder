{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "assetGroup", "decision", "status", "businessOwner", "evidence", "classification", "retention", "approval", "reconciliation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetGroup": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
    "decision": { "enum": ["MIGRATE", "SUBSTITUTE", "DECOMMISSION"] },
    "status": { "const": "APPROVED" },
    "classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
  }
}
