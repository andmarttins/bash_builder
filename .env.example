# Dokploy: configure real values in the project environment; do not commit .env.
NODE_ENV=production
APP_ORIGIN=https://app.example.com,https://www.app.example.com
# Generate once with a password manager. It authorizes only the first administrator setup.
BOOTSTRAP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
API_PORT=3000
WEB_PORT=8080

# PostgreSQL is a separate Dokploy Database service. The bootstrap URL is only
# mounted into the one-off db-bootstrap service; do not give it to the app.
POSTGRES_DB=builder
APP_MIGRATOR_DB_PASSWORD=change-before-first-install
APP_RUNTIME_DB_PASSWORD=change-before-first-install
APP_WORKER_DB_PASSWORD=change-before-first-install
BOOTSTRAP_DATABASE_URL=postgresql://builder_admin:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder
MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder
DATABASE_URL=postgresql://app_runtime:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder
WORKER_DATABASE_URL=postgresql://app_worker:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder

# Redis is a separate Dokploy Redis service, reachable only on the internal network.
REDIS_URL=redis://:change-before-first-install@REDIS_INTERNAL_HOST:6379

# Kafka-compatible broker; Redpanda is included for the first Dokploy installation.
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=builder-worker
KAFKA_GROUP_ID=builder-worker-v1

# Optional internal Prometheus scrape protection. Leave unset to disable both
# API and worker metric endpoints until an internal scraper is configured.
# Set only in the protected runtime secret store; leaving it empty disables metrics.
METRICS_TOKEN=
WORKER_METRICS_PORT=9464

# Keep batch * timeout inside the lease. Webhook secrets are protected,
# tenant-namespaced variables, e.g. INTEGRATION_ACME_WEBHOOK_SECRET.
WEBHOOK_DELIVERY_POLL_INTERVAL_MS=2000
WEBHOOK_DELIVERY_BATCH_SIZE=10
WEBHOOK_DELIVERY_LEASE_SECONDS=70
WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_DELIVERY_MAX_BYTES=262144

# Optional private S3-compatible storage. The API proxies bytes; do not expose
# the MinIO service publicly and do not commit the runtime credentials.
S3_ENDPOINT=http://BUILDER_OBJECT_STORAGE_INTERNAL_HOST:9000
S3_REGION=us-east-1
S3_BUCKET=builder-assets
S3_ACCESS_KEY_ID=replace-with-runtime-access-key
S3_SECRET_ACCESS_KEY=replace-with-runtime-secret
# Dedicated worker identity: grant only DeleteObject on this bucket/prefix.
FILE_CLEANUP_S3_ENDPOINT=http://BUILDER_OBJECT_STORAGE_INTERNAL_HOST:9000
FILE_CLEANUP_S3_REGION=us-east-1
FILE_CLEANUP_S3_BUCKET=builder-assets
FILE_CLEANUP_S3_ACCESS_KEY_ID=replace-with-cleanup-access-key
FILE_CLEANUP_S3_SECRET_ACCESS_KEY=replace-with-cleanup-secret
