# Dokploy: configure real values in the project environment; do not commit .env.
NODE_ENV=production
APP_ORIGIN=https://app.example.com
API_PORT=3000
WEB_PORT=8080

# PostgreSQL is a separate Dokploy Database service. The bootstrap URL is only
# mounted into the one-off db-bootstrap service; do not give it to the app.
POSTGRES_DB=builder
APP_MIGRATOR_DB_PASSWORD=change-before-first-install
APP_RUNTIME_DB_PASSWORD=change-before-first-install
BOOTSTRAP_DATABASE_URL=postgresql://builder_admin:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder
MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder
DATABASE_URL=postgresql://app_runtime:change-before-first-install@POSTGRES_INTERNAL_HOST:5432/builder

# Redis is a separate Dokploy Redis service, reachable only on the internal network.
REDIS_URL=redis://:change-before-first-install@REDIS_INTERNAL_HOST:6379

# Kafka-compatible broker; Redpanda is included for the first Dokploy installation.
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=builder-worker
KAFKA_GROUP_ID=builder-worker-v1
