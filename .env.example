# Dokploy: configure real values in the project environment; do not commit .env.
NODE_ENV=production
APP_ORIGIN=https://app.example.com
API_PORT=3000
WEB_PORT=8080

# PostgreSQL (the migrator account owns schema; runtime is RLS-restricted)
POSTGRES_DB=builder
POSTGRES_USER=postgres_bootstrap
POSTGRES_PASSWORD=change-before-first-install
APP_MIGRATOR_DB_PASSWORD=change-before-first-install
APP_RUNTIME_DB_PASSWORD=change-before-first-install
MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-before-first-install@postgres:5432/builder
DATABASE_URL=postgresql://app_runtime:change-before-first-install@postgres:5432/builder

# Kafka-compatible broker; Redpanda is included for the first Dokploy installation.
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=builder-worker
KAFKA_GROUP_ID=builder-worker-v1
